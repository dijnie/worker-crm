    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/661a4884-fb10-4867-7b4e-b72763d12100/preview",
    "publish": true
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.4",
    "@carbon/icons-react": "^11.88.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "^8.21.3",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "better-auth": "1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.44.0",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "^7.87.0",
    "react-server-dom-webpack": "^19.3.0",
    "swagger-ui-react": "^5.32.15",
    "tailwind-merge": "^3.6.0",
    "vinext": "1.0.0-beta.9",
    "zod": "4.6.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@cloudflare/vite-plugin": "^1.54.6",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "auth": "1.7.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.1",
    "jsonc-parser": "3.3.1",
    "miniflare": "5.20260910.0-alpha",
    "openapi-types": "^12.1.3",
    "playwright": "1.63.0",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "^8.2.2",
    "wrangler": "^4.130.0"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate && vinext dev --port 3000",
    "build": "vinext build",
    "test:schema": "node --test tests/schema.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:services": "node --test tests/records.test.mjs tests/activities.test.mjs tests/fields.test.mjs tests/stats-auth.test.mjs tests/api.test.mjs",
    "start": "npm run db:migrate:built && wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state --port 3000 --local-protocol http --var AUTH_BASE_URL:http://localhost:3000",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/d1-migrations.mjs --apply",
    "db:migrate:built": "node scripts/d1-migrations.mjs --apply --built",
    "db:inspect": "node scripts/d1-migrations.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test:auth": "node --test tests/auth.test.mjs tests/email.test.mjs tests/members.test.mjs"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  },
  "onlyBuiltDependencies": [
    "esbuild",
    "workerd"
  ],
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260910.1": true
  }
}
